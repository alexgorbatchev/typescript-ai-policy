{
  "name": "@alexgorbatchev/typescript-ai-policy",
  "version": "14.0.2",
  "description": "Shared TypeScript AI policy configs and Oxlint rules",
  "homepage": "https://github.com/alexgorbatchev/typescript-ai-policy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgorbatchev/typescript-ai-policy.git"
  },
  "bugs": {
    "url": "https://github.com/alexgorbatchev/typescript-ai-policy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "typescript-ai-policy": "./dist/bin/typescript-ai-policy.js"
  },
  "exports": {
    "./oxfmt-config": {
      "types": "./dist/oxfmt-config.d.ts",
      "import": "./dist/oxfmt-config.js"
    },
    "./oxlint-config": {
      "types": "./dist/oxlint-config.d.ts",
      "import": "./dist/oxlint-config.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/oxlint-plugin.d.ts",
      "import": "./dist/oxlint-plugin.js"
    }
  },
  "peerDependencies": {
    "@typescript/native": "^7.0.2",
    "oxfmt": ">=0.49.0 <1.0.0",
    "oxlint": "^1.64.0",
    "typescript": ">=6.0.2"
  },
  "peerDependenciesMeta": {
    "@typescript/native": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "./scripts/check.sh",
    "cli": "bun src/cli/cli.ts",
    "fix:semantic": "bun src/cli/cli.ts fix-semantic",
    "lint:target": "./scripts/lint-target.sh",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@alexgorbatchev/dedent-string": "^1.0.1",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/rule-tester": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "0.23.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "minimatch": "^10.2.6",
    "package-manager-detector": "^1.9.0"
  }
}
